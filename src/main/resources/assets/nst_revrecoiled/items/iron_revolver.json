{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": ["firstperson_righthand", "firstperson_lefthand", "thirdperson_righthand", "thirdperson_lefthand", "head", "ground"],
        "model": {
          "type": "minecraft:special",
          "base": "nst_revrecoiled:item/iron_revolver",
          "model": {
            "type": "geckolib:geckolib"
          }
        }
      },
      {
        "when": ["gui", "fixed"],
        "model": {
          "type": "minecraft:model",
          "model": "nst_revrecoiled:item/iron_revolver_item"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "nst_revrecoiled:item/iron_revolver_item"
    }
  }
}
